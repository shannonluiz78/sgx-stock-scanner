<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Stock Signals Dashboard</title>
  <style>
    :root {
      --bg-color: #0f172a;
      --card-bg: #1e293b;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --border-color: #334155;
      --buy-color: #22c55e;
      --watch-color: #eab308;
      --sell-color: #ef4444;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg-color);
      color: var(--text-main);
      padding: 24px;
      line-height: 1.5;
    }

    .header {
      max-width: 1200px;
      margin: 0 auto 24px auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border-color);
    }

    .header h1 {
      font-size: 1.75rem;
      font-weight: 700;
    }

    .timestamp {
      background-color: var(--card-bg);
      padding: 8px 14px;
      border-radius: 20px;
      font-size: 0.875rem;
      color: var(--text-muted);
      border: 1px solid var(--border-color);
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 20px;
    }

    .card {
      background-color: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 12px;
    }

    .ticker {
      font-size: 1.25rem;
      font-weight: 700;
      color: #38bdf8;
    }

    .company-name {
      font-size: 0.875rem;
      color: var(--text-muted);
    }

    .badge {
      font-size: 0.75rem;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 6px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .badge-BUY {
      background-color: rgba(34, 197, 94, 0.2);
      color: var(--buy-color);
      border: 1px solid var(--buy-color);
    }

    .badge-WATCH {
      background-color: rgba(234, 179, 8, 0.2);
      color: var(--watch-color);
      border: 1px solid var(--watch-color);
    }

    .badge-SELL {
      background-color: rgba(239, 68, 68, 0.2);
      color: var(--sell-color);
      border: 1px solid var(--sell-color);
    }

    .price-row {
      display: flex;
      align-items: baseline;
      gap: 8px;
      margin-bottom: 16px;
    }

    .price {
      font-size: 1.75rem;
      font-weight: 700;
    }

    .sector {
      font-size: 0.8rem;
      background-color: #334155;
      padding: 2px 8px;
      border-radius: 4px;
      color: var(--text-muted);
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      background-color: rgba(15, 23, 42, 0.5);
      padding: 12px;
      border-radius: 8px;
      font-size: 0.875rem;
      margin-bottom: 16px;
    }

    .stat-item {
      display: flex;
      flex-direction: column;
    }

    .stat-label {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .stat-value {
      font-weight: 600;
    }

    .sparkline-container {
      margin-top: auto;
      padding-top: 10px;
    }

    .sparkline-title {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-bottom: 4px;
    }

    svg.sparkline {
      width: 100%;
      height: 45px;
      stroke: #38bdf8;
      stroke-width: 2;
      fill: none;
    }

    .error-box {
      grid-column: 1 / -1;
      background-color: rgba(239, 68, 68, 0.1);
      border: 1px solid var(--sell-color);
      color: var(--text-main);
      padding: 20px;
      border-radius: 8px;
      text-align: center;
    }
  </style>
</head>
<body>

  <header class="header">
    <h1>SG Stock Signals</h1>
    <div class="timestamp" id="last-updated">Loading timestamp...</div>
  </header>

  <main class="container" id="dashboard-container">
    <p style="grid-column: 1 / -1; text-align: center; color: var(--text-muted);">
      Loading stock signals...
    </p>
  </main>

  <script>
    async function loadDashboard() {
      const container = document.getElementById('dashboard-container');
      const timeElem = document.getElementById('last-updated');

      try {
        // Fetch data.json relative to current directory
        const response = await fetch('./data.json');
        
        if (!response.ok) {
          throw new Error(`HTTP ${response.status}: Unable to load data.json`);
        }

        const json = await response.json();

        // 1. Display Updated Timestamp
        if (json.updated_at_sgt) {
          timeElem.textContent = `Updated: ${json.updated_at_sgt}`;
        } else {
          timeElem.textContent = 'Updated: N/A';
        }

        // 2. Extract stock list safely (handles wrapper object OR flat array)
        const stocks = Array.isArray(json) ? json : (json.data || []);

        if (!stocks || stocks.length === 0) {
          container.innerHTML = `<div class="error-box">No stock data found in data.json.</div>`;
          return;
        }

        // 3. Clear container and render stock cards
        container.innerHTML = '';

        stocks.forEach(stock => {
          const card = document.createElement('div');
          card.className = 'card';

          const signal = stock.trade_signal || 'WATCH';
          const sparklineSvg = generateSparkline(stock.daily_prices || []);

          card.innerHTML = `
            <div>
              <div class="card-header">
                <div>
                  <div class="ticker">${stock.ticker}</div>
                  <div class="company-name">${stock.name}</div>
                </div>
                <span class="badge badge-${signal}">${signal}</span>
              </div>

              <div class="price-row">
                <span class="price">$${Number(stock.price).toFixed(2)}</span>
                <span class="sector">${stock.sector}</span>
              </div>

              <div class="stats-grid">
                <div class="stat-item">
                  <span class="stat-label">Stop Loss</span>
                  <span class="stat-value" style="color: var(--sell-color);">$${Number(stock.stop_loss).toFixed(2)}</span>
                </div>
                <div class="stat-item">
                  <span class="stat-label">Take Profit</span>
                  <span class="stat-value" style="color: var(--buy-color);">$${Number(stock.take_profit).toFixed(2)}</span>
                </div>
                <div class="stat-item">
                  <span class="stat-label">Confidence</span>
                  <span class="stat-value">${stock.confidence_score}%</span>
                </div>
                <div class="stat-item">
                  <span class="stat-label">Pos Size / ROE</span>
                  <span class="stat-value">${stock.pos_size_pct || 'N/A'} / ${stock.roe || 'N/A'}</span>
                </div>
              </div>
            </div>

            <div class="sparkline-container">
              <div class="sparkline-title">Recent Price Trend</div>
              ${sparklineSvg}
            </div>
          `;

          container.appendChild(card);
        });

      } catch (error) {
        console.error('Error rendering dashboard:', error);
        container.innerHTML = `
          <div class="error-box">
            <h3>Failed to load dashboard data</h3>
            <p style="margin-top: 8px; font-size: 0.9rem; color: var(--text-muted);">
              ${error.message}
            </p>
            <p style="margin-top: 12px; font-size: 0.8rem;">
              <strong>Note:</strong> If running locally on your computer, open this page via a local web server (or VS Code Live Server) rather than double-clicking the HTML file.
            </p>
          </div>
        `;
      }
    }

    // SVG Sparkline Generator function
    function generateSparkline(prices) {
      if (!prices || prices.length < 2) return '';

      const min = Math.min(...prices);
      const max = Math.max(...prices);
      const range = (max - min) || 1;
      const width = 300;
      const height = 40;

      const points = prices.map((price, idx) => {
        const x = (idx / (prices.length - 1)) * width;
        const y = height - ((price - min) / range) * (height - 8) - 4;
        return `${x.toFixed(1)},${y.toFixed(1)}`;
      }).join(' ');

      const isUp = prices[prices.length - 1] >= prices[0];
      const strokeColor = isUp ? '#22c55e' : '#ef4444';

      return `
        <svg class="sparkline" viewBox="0 0 ${width} ${height}" preserveAspectRatio="none">
          <polyline points="${points}" style="stroke: ${strokeColor};" />
        </svg>
      `;
    }

    // Run on page load
    document.addEventListener('DOMContentLoaded', loadDashboard);
  </script>
</body>
</html>
